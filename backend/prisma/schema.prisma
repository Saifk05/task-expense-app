// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init



generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid())

  firstName   String
  lastName    String
  email       String   @unique
  phoneNumber String?

  address   String?
  building  String?
  locality  String?
  city      String?
  pincode   String?

  latitude   Decimal? @db.Decimal(10, 8)
  longitude  Decimal? @db.Decimal(11, 8)

  passwordHash             String
  currentRefreshTokenHash  String?
  isAccountLocked          Boolean  @default(false)
  failedLoginAttempts      Int      @default(0)
  lockUntil                DateTime?

  profilePictureUrl String?
  profilePictureId  String? 
  
  isActive          Boolean @default(true)
  tasks Task[]
  taskCategories TaskCategory[]
  
  accounts Account[]
  transactions Transaction[]
  budgets       Budget[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phoneNumber])
  @@index([city])
  @@index([pincode])
}


model Task {
  id        String   @id @default(uuid())
  userId    String

  title       String
  description String?

  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)

  startDate   DateTime
  dueDate     DateTime

  categoryId String?
  cancelledReason String?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, startDate])
}

model TaskCategory {
  id        String   @id @default(uuid())
  userId    String

  name      String
  parentId  String?   // null = main category

  parent    TaskCategory?  @relation("TaskCategoryHierarchy", fields: [parentId], references: [id])
  children  TaskCategory[] @relation("TaskCategoryHierarchy")

  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentId])

  @@unique([userId, name, parentId]) //  Prevent duplicate sibling categories
}

model Account {
  id       String   @id @default(uuid())
  userId   String

  name     String   // Example: HDFC Savings
  type     AccountType
  balance  Decimal  @db.Decimal(15,2) @default(0)

  transactions Transaction[]

  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}



model Category {
  id       String   @id @default(uuid())
  userId   String?  // NULL = global category, NOT NULL = user custom

  name     String
  type     CategoryType
  parentId String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  transactions Transaction[]
  budgets      Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
}

model Transaction {
  id        String   @id @default(uuid())

  userId    String
  accountId String
  categoryId String

  title        String
  description  String?

  type         TransactionType

  quantity     Int?       @default(1)
  unitPrice    Decimal?   @db.Decimal(15,2)
  totalAmount  Decimal    @db.Decimal(15,2)

  transactionDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([userId, transactionDate])
  @@index([userId, type])
}

model Budget {
  id         String   @id @default(uuid())

  userId     String
  categoryId String

  amountLimit Decimal  @db.Decimal(15,2)

  startDate  DateTime
  endDate    DateTime

  thresholdPercentage Int? // e.g., 80 (notify at 80%)

  isActive   Boolean   @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@index([userId, startDate, endDate])

  @@unique([userId, categoryId, startDate, endDate])
}

model Notification {
  id        String   @id @default(uuid())

  userId    String

  title     String
  message   String
  type      NotificationType

  isRead    Boolean  @default(false)
  isSent    Boolean  @default(false)

  deliveryChannel NotificationChannel @default(IN_APP)

  sentAt    DateTime?
  readAt    DateTime?

  relatedBudgetId       String?
  relatedTransactionId  String?
  relatedTaskId         String?

  task Task? @relation(fields: [relatedTaskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([isSent])
  @@index([type])
  @@index([relatedTaskId])
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  TRANSACTION_ALERT

  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_OVERDUE
  
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
}


enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  NEED
  WANT
  SAVING
  INVESTMENT
  INCOME
}

enum AccountType {
  BANK
  CASH
  CREDIT_CARD
  WALLET
  INVESTMENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
